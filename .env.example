# Database configuration
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat_password
POSTGRES_DB=chat

# JWT configuration
JWT_SECRET=change-me-to-a-long-random-string
JWT_MAX_LIFETIME_DAYS=7
JWT_ACCESS_LIFETIME_MINUTES=15

# Web server limit configuration
JSON_BODY_LIMIT_BYTES=1048576
AVATAR_MAX_BYTES=5242880
MULTIPART_MAX_FIELDS=8
MULTIPART_MAX_PARTS=10
HTTP_RATE_LIMIT_WINDOW_SECONDS=60
HTTP_RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Message limit configuration
MESSAGE_RATE_LIMIT_WINDOW_SECONDS=60
MESSAGE_RATE_LIMIT_MAX_MESSAGES=30
MESSAGE_MAX_LENGTH=4000

# WebSocket limit configuration
WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=10
WEBSOCKET_RATE_LIMIT_MAX_EVENTS=40
WEBSOCKET_CONNECTION_WINDOW_SECONDS=60
WEBSOCKET_CONNECTION_MAX_ATTEMPTS=20
DUPLICATE_REQUEST_WINDOW_SECONDS=10
